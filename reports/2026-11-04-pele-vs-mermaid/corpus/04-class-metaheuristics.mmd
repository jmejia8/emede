classDiagram
    direction TB
    class AbstractAlgorithm {
        <<abstract>>
        +information Information
        +options Options
        +initialize!(status, problem)
        +update_state!(status, problem)
        +stop_criteria!(status) bool
    }
    class NSGA2 {
        +N Int
        +p_cr Float64
        +η_cr Float64
        +p_m Float64
    }
    class SMS_EMOA {
        +N Int
        +n_samples Int
    }
    class BCAOperator {
        +ul AbstractAlgorithm
        +ll AbstractAlgorithm
    }
    class State~T~ {
        +best_sol T
        +population Vector~T~
        +iteration Int
        +f_calls Int
    }
    class Problem {
        +f Function
        +bounds Matrix~Float64~
        +nobjectives() Int
    }
    AbstractAlgorithm <|-- NSGA2
    AbstractAlgorithm <|-- SMS_EMOA
    AbstractAlgorithm <|-- BCAOperator
    BCAOperator o-- "2" AbstractAlgorithm : upper / lower
    AbstractAlgorithm ..> State : updates
    AbstractAlgorithm ..> Problem : evaluates
    State "1" *-- "many" Solution : contains
    class Solution {
        +x Vector~Float64~
        +f Vector~Float64~
        +sum_violations Float64
    }
