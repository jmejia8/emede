gantt
    title Bilevel MOEA paper plan
    dateFormat YYYY-MM-DD
    axisFormat %b %d
    excludes weekends
    section Method
        Literature review          :done,    lit, 2026-09-01, 10d
        Operator design            :done,    op,  after lit, 12d
        Implementation in Julia    :active,  impl, after op, 15d
    section Experiments
        Benchmark suite setup      :         bench, after op, 5d
        Pilot runs                 :crit,    pilot, after impl, 4d
        Full runs (30 seeds)       :crit,    full, after pilot, 10d
        Statistical analysis       :         stats, after full, 5d
    section Writing
        Draft                      :         draft, after pilot, 15d
        Internal review            :milestone, rev, after draft, 0d
        Camera ready               :crit,    cam, after stats, 6d
        Submission deadline        :milestone, dl, 2026-12-15, 0d
