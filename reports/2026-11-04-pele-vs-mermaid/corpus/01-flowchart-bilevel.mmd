flowchart TD
    start([Start]) --> init[Initialize upper-level population]
    init --> eval_ul

    subgraph UL[Upper level]
        eval_ul[Evaluate leader decision x] --> sel{Budget left?}
        sel -- yes --> var[Variation: SBX + polynomial mutation]
        var --> eval_ul
    end

    subgraph LL[Lower level for each x]
        solve[Solve follower problem] --> conv{Converged?}
        conv -- no --> refine[Refine with local search]
        refine --> solve
        conv -- yes --> ystar[(y* archive)]
    end

    eval_ul -. calls .-> solve
    ystar -. returns y* .-> eval_ul
    sel -- no --> front[Non-dominated front]
    front --> hv[Compute HV / IGD]
    hv --> stop([End])

    classDef io fill:#eef,stroke:#446,stroke-width:2px
    classDef store fill:#efe,stroke:#464
    class start,stop io
    class ystar store
