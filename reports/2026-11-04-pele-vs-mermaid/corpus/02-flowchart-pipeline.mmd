flowchart LR
    md["**report.md**"] --> fm[/Front matter/]
    fm --> math[[Math fences]]
    math --> comrak{{Comrak parser}}
    comrak --> fmt("MathJax formatter")
    fmt --> img[Rewrite image srcs]
    img --> amm>Ammonia sanitize]
    amm --> html[(HTML)]
    html ==> view["WebView _reader_"]
    html --> share[LAN share page]
    html --> pdf[PDF via print]
    view -.-> mj[MathJax]
    view -.-> mer[Mermaid]
    view -.-> hl[highlight.js]
    linkStyle 7 stroke-width:3px
